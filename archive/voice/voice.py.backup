import queue
import threading
import time
import tempfile
from pathlib import Path

try:
    import pyttsx3
except ImportError:
    pyttsx3 = None

try:
    import sounddevice as sd
    import speech_recognition as sr
    from scipy.io.wavfile import write
except ImportError:
    sd = None
    sr = None
    write = None


class AkshuVoice:
    """Background text-to-speech and microphone input for AKSHU."""

    def __init__(self):
        self.recognizer = sr.Recognizer() if sr else None
        self.sample_rate = 16000
        self.record_seconds = 5

        self._speech_queue = queue.Queue(maxsize=8)
        self._closed = threading.Event()
        self._muted = threading.Event()
        self._ready = threading.Event()
        self._worker_error = None

        self._last_message = ""
        self._last_message_time = 0.0
        self._dedupe_lock = threading.Lock()

        self._worker = threading.Thread(
            target=self._speech_worker,
            name="AKSHU-Voice",
            daemon=True,
        )
        self._worker.start()

    def _speech_worker(self):
        """Own the TTS engine on one thread and drain queued speech before exit."""
        engine = None
        com_initialized = False

        try:
            try:
                import pythoncom
                pythoncom.CoInitialize()
                com_initialized = True
            except ImportError:
                pass

            if pyttsx3 is None:
                self._worker_error = "pyttsx3 is not installed."
                print(
                    "[AKSHU VOICE ERROR] pyttsx3 is not installed. "
                    "Run: python -m pip install pyttsx3",
                    flush=True,
                )
                return

            try:
                engine = pyttsx3.init(driverName="sapi5")
            except Exception as exc:
                print(
                    "[AKSHU VOICE] SAPI5 initialisation failed; "
                    f"trying the default driver: {exc}",
                    flush=True,
                )
                engine = pyttsx3.init()

            engine.setProperty("rate", 175)
            engine.setProperty("volume", 1.0)

            self._ready.set()
            print("[AKSHU VOICE] Speech engine ready.", flush=True)

            # IMPORTANT: Do not exit just because close() was requested.
            # Process all messages already queued, then stop at the sentinel.
            while True:
                try:
                    message = self._speech_queue.get(timeout=0.25)
                except queue.Empty:
                    if self._closed.is_set():
                        break
                    continue

                try:
                    if message is None:
                        break

                    if self._muted.is_set():
                        print("[AKSHU VOICE] Queued speech skipped: muted.", flush=True)
                        continue

                    print("[AKSHU VOICE] Speaking:", message, flush=True)
                    engine.say(message)
                    engine.runAndWait()
                    print("[AKSHU VOICE] Speech finished.", flush=True)

                except Exception as exc:
                    print(f"[AKSHU TTS ERROR] {exc}", flush=True)

                finally:
                    self._speech_queue.task_done()

        except Exception as exc:
            self._worker_error = str(exc)
            print(f"[AKSHU VOICE ERROR] {exc}", flush=True)

        finally:
            if engine is not None:
                try:
                    engine.stop()
                except Exception:
                    pass

            if com_initialized:
                try:
                    import pythoncom
                    pythoncom.CoUninitialize()
                except Exception:
                    pass

            print("[AKSHU VOICE] Speech worker stopped.", flush=True)

    def speak(self, text):
        """Queue speech. Returns True when accepted, False when skipped."""
        if not text or self._closed.is_set() or self._muted.is_set():
            return False

        message = str(text).strip()
        if not message:
            return False

        now = time.monotonic()

        with self._dedupe_lock:
            if (
                message == self._last_message
                and now - self._last_message_time < 3.0
            ):
                print(
                    "[AKSHU VOICE] Duplicate announcement suppressed.",
                    flush=True,
                )
                return False

            try:
                self._speech_queue.put_nowait(message)
            except queue.Full:
                # Remove one stale item so the newest guidance can be queued.
                try:
                    self._speech_queue.get_nowait()
                    self._speech_queue.task_done()
                except queue.Empty:
                    pass

                try:
                    self._speech_queue.put_nowait(message)
                except queue.Full:
                    print("[AKSHU VOICE] Queue full; announcement skipped.", flush=True)
                    return False

            self._last_message = message
            self._last_message_time = now

        print("[AKSHU VOICE QUEUED]", message, flush=True)
        return True

    def mute(self):
        self._muted.set()

    def unmute(self):
        self._muted.clear()

    @property
    def is_muted(self):
        return self._muted.is_set()

    def listen(self, timeout=5, phrase_time_limit=8):
        """Record microphone audio and convert it to text."""
        if sd is None or sr is None or write is None:
            print(
                "[AKSHU MIC ERROR] Microphone dependencies are missing. "
                "Install sounddevice, SpeechRecognition and scipy.",
                flush=True,
            )
            return ""

        try:
            print("[AKSHU] Listening. Speak now...", flush=True)

            recording = sd.rec(
                int(self.record_seconds * self.sample_rate),
                samplerate=self.sample_rate,
                channels=1,
                dtype="int16",
            )
            sd.wait()

            with tempfile.NamedTemporaryFile(suffix=".wav", delete=False) as temp_file:
                temp_path = Path(temp_file.name)

            try:
                write(str(temp_path), self.sample_rate, recording)

                with sr.AudioFile(str(temp_path)) as source:
                    audio = self.recognizer.record(source)

                result = self.recognizer.recognize_google(audio)
                print("[YOU]", result, flush=True)
                return result

            finally:
                try:
                    temp_path.unlink(missing_ok=True)
                except OSError:
                    pass

        except sr.UnknownValueError:
            print("[AKSHU] I could not understand that.", flush=True)
            return ""
        except sr.RequestError as exc:
            print(f"[AKSHU MIC ERROR] Speech recognition service error: {exc}", flush=True)
            return ""
        except Exception as exc:
            print(f"[AKSHU MIC ERROR] {exc}", flush=True)
            return ""

    def close(self):
        """Stop accepting speech, finish queued messages, then stop the worker."""
        if self._closed.is_set():
            return

        self._closed.set()

        # A sentinel is placed AFTER pending speech, so the worker drains it first.
        try:
            self._speech_queue.put(None, timeout=5)
        except queue.Full:
            print(
                "[AKSHU VOICE] Could not queue shutdown signal; "
                "worker may still be processing speech.",
                flush=True,
            )

        if threading.current_thread() is not self._worker:
            self._worker.join(timeout=15)

            if self._worker.is_alive():
                print(
                    "[AKSHU VOICE WARNING] Speech worker is still busy. "
                    "Allow it to finish before closing the terminal.",
                    flush=True,
                )
